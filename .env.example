# Local: MongoDB via docker-compose.yml. In production, point this at a
# real hosted MongoDB instead (e.g. a Railway/Render MongoDB add-on, or
# MongoDB Atlas) — the app reads this generically, no code change needed.
MONGODB_URI=mongodb://localhost:27017/shopify_theme_auditor

# The core audit pipeline is fully deterministic and requires no AI/embedding
# API keys — no Voyage, no Claude/Anthropic, no OpenAI. See the phase-*-updated.md
# docs for the architectural decision.

# Phase 5 — optional Google Sheets export (core app works without it).
# OAuth client from https://console.cloud.google.com — a Web application
# OAuth client with the Sheets + Drive APIs enabled and this redirect URI
# registered exactly. See /settings in the app to connect an account once
# these are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# In production, GOOGLE_REDIRECT_URI must be the deployed https:// domain
# (e.g. https://your-app.up.railway.app/api/auth/google/callback), and that
# exact URI must also be added to the OAuth client's "Authorized redirect
# URIs" in Google Cloud Console — the client was originally created for
# localhost only, so this is an *addition*, not a replacement.

# Optional — Page Speed live check (core app works without it). An API key
# from https://console.cloud.google.com with the "PageSpeed Insights API"
# enabled, used to get a real Lighthouse performance score + Core Web Vitals
# for each audit's demo store URL(s). Without it, the app automatically
# falls back to Playwright-based timing heuristics (less authoritative, but
# needs no setup).
# PAGESPEED_API_KEY=

# Optional locally, strongly recommended once deployed — HTTP Basic Auth
# gate (middleware.ts) in front of the whole app, since it has no user
# accounts/login of its own. Unset (the default) = no gate at all, so local
# dev is unaffected; set both to actually password-protect a live
# deployment. Pick a real password, not a placeholder.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# GA4 Analytics (see ga4-analytics-architecture.md) — optional; the rest of
# the app works without any of these. Reuses GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET above (same Google Cloud OAuth client), but with its
# own callback, which must also be added to that client's "Authorized
# redirect URIs". The Google Analytics Data API and Admin API must be
# enabled in the same Google Cloud project.
# Public base URL of this app, no trailing slash — used to build OAuth
# callbacks. Local: http://localhost:3000. Production: the deployed https URL.
# APP_URL=http://localhost:3000
# Defaults to ${APP_URL}/api/analytics/google/callback when unset.
# GA4_OAUTH_REDIRECT_URI=http://localhost:3000/api/analytics/google/callback
# 32 random bytes, base64 — encrypts stored GA4 OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored token unreadable (each account must reconnect).
# ANALYTICS_TOKEN_ENCRYPTION_KEY=
# GA4 sync (optional). The background sync runs every 15 minutes and syncs
# each mapped theme about every 6 hours. Set to 1 to turn it off, e.g. in
# local dev ("Sync now" still works).
# ANALYTICS_SYNC_DISABLED=1
# Earliest date the first sync fetches (YYYY-MM-DD). Unset = all history GA4
# still has for the property (back to its creation). Only set this if
# MongoDB storage becomes a concern.
# ANALYTICS_HISTORY_START_DATE=2024-01-01
# Analytics engine (optional). Range-level unique users are fetched from GA4
# on demand and cached in MongoDB. Set to 1 to never ask GA4 at read time;
# user figures then fall back to summed daily users (labelled as such).
# ANALYTICS_UNIQUE_USERS_DISABLED=1
